# ============================================================
# POSTIZ - CONFIGURAÇÃO GERAL
# ============================================================
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007

# Gere uma chave aleatória: openssl rand -hex 32
JWT_SECRET=TROQUE_POR_UMA_CHAVE_ALEATORIA_SEGURA

# ============================================================
# BANCO DE DADOS
# ============================================================
DATABASE_URL=postgresql://postiz:postiz@postiz-postgres:5432/postiz

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://postiz-redis:6379

# ============================================================
# ARMAZENAMENTO DE MÍDIA
# ============================================================
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads

# Para usar Cloudflare R2 (opcional):
# STORAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKETNAME=
# CLOUDFLARE_BUCKET_URL=

# ============================================================
# FACEBOOK + INSTAGRAM
# Criar app em: https://developers.facebook.com
# Tipo: Business → Permissões: instagram_content_publish, pages_manage_posts
# ============================================================
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ============================================================
# TIKTOK
# Criar app em: https://developers.tiktok.com
# Produto: Content Posting API → Escopos: video.publish
# ============================================================
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ============================================================
# YOUTUBE (Google)
# Criar projeto em: https://console.cloud.google.com
# Ativar: YouTube Data API v3 → Credenciais OAuth 2.0
# ============================================================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ============================================================
# X (TWITTER)
# Criar app em: https://developer.x.com
# Plano Free: 500 posts/mês. Ativar OAuth 2.0 com escopos: tweet.write, users.read
# ============================================================
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ============================================================
# LINKEDIN
# Criar app em: https://developer.linkedin.com
# Produto: Share on LinkedIn → Escopos: w_member_social
# ============================================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
